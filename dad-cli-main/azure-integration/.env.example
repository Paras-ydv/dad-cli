# Shared API key protecting every backend route.
# Must match TESTPILOT_API_KEY (agent) and VITE_API_KEY (dashboard).
API_KEY=

# Directory the backend serves screenshots from.
# Defaults to ../screenshots relative to the process working directory.
TESTPILOT_SCREENSHOT_DIR=

# Auth
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Cosmos DB
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DB=

# Vision
AZURE_VISION_ENDPOINT=
AZURE_VISION_KEY=

# Monitor
AZURE_LOG_WORKSPACE=
