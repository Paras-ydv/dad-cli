{
  "name": "testpilot-ai",
  "displayName": "TestPilot AI",
  "description": "Autonomous runtime discovery & integration testing agent",
  "publisher": "testpilot-ai",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:testpilotView",
    "onCommand:testpilot.start"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "testpilot.start",
        "title": "▶ Start TestPilot Test"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "testpilot",
          "title": "TestPilot",
          "icon": "media/testpilot.svg"
        }
      ]
    },
    "views": {
      "testpilot": [
        {
          "id": "testpilotView",
          "name": "TestPilot Controls"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "testpilot.start",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ."
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
