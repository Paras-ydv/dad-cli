# ---------------------------------------------------------------
# TestPilot AI - agent runtime configuration
# Copy to .env (root) and runtime-discovery/.env, then fill in.
# ---------------------------------------------------------------

# Backend (azure-integration) base URL and shared API key.
# TESTPILOT_API_KEY must match API_KEY in azure-integration/.env
TESTPILOT_API_URL=http://localhost:5050
TESTPILOT_API_KEY=

# Embeddings: "local" (default, @xenova/transformers, 384-dim)
# or "azure" (Azure OpenAI, 1536-dim)
EMBEDDING_PROVIDER=local

# Only required when EMBEDDING_PROVIDER=azure
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Qdrant vector database
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=testpilot_kb
